# Em produção, configure a URL pública do backend, incluindo /api.
# Em desenvolvimento, o proxy do Vite encaminha /api para localhost:8080.
# VITE_API_URL=https://seu-backend.exemplo.com/api

# Credenciais públicas de demonstração exibidas na tela de login.
# Mantenha login e senha iguais aos valores de BOOTSTRAP_ADMIN_* do backend.
VITE_TEST_LOGIN=admin@aerogym.local
VITE_TEST_PASSWORD=SenhaSuperForte
